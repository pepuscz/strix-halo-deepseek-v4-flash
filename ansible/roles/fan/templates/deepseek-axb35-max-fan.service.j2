[Unit]
Description=Maximum cooling for the DeepSeek model workload
After=systemd-modules-load.service
StopWhenUnneeded=yes

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/deepseek-axb35-fan max
ExecStop=/usr/local/sbin/deepseek-axb35-fan auto
RemainAfterExit=yes
TimeoutStartSec=30
TimeoutStopSec=15
