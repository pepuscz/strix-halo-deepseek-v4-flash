[Unit]
Description=Demand-based cooling for the DeepSeek model workload
Requisite={{ deepseek_service.name }} deepseek-axb35-max-fan.service
After={{ deepseek_service.name }} deepseek-axb35-max-fan.service
PartOf={{ deepseek_service.name }}

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/sbin/deepseek-fan-governor --mode control --interval-seconds {{ deepseek_fan.governor.interval_seconds }} --idle-seconds {{ deepseek_fan.governor.idle_seconds }} --busy-threshold {{ deepseek_fan.governor.busy_threshold_pct }} --lock-file /run/lock/deepseek-fan-governor.lock
ExecStopPost=/usr/local/sbin/deepseek-fan-governor --set-state max
Restart=on-failure
RestartSec=1
TimeoutStopSec=60
Nice=19
CPUWeight=1
CPUQuota=1%
IOSchedulingClass=idle
OOMScoreAdjust=500
MemoryMax=64M
TasksMax=16
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/lock {{ deepseek_fan.sysfs }}
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy={{ deepseek_service.name }}
