+TEST_CASE(ServerUnitFixture, test_deepseek4_render_reasoning_effort_max) {
+    std::vector<ChatMessage> msgs = {
+        {"system", "system message", ""},
+        {"user", "hard problem", ""},
+    };
+    const std::string out = render_chat_template(
+        msgs, ChatFormat::DEEPSEEK4,
+        /*add_generation_prompt=*/true,
+        /*enable_thinking=*/true,
+        /*tools_json=*/"",
+        /*reasoning_effort=*/"max");
+    const std::string bos = "<｜begin▁of▁sentence｜>";
+    const std::string prefix =
+        "Reasoning Effort: Absolute maximum with no shortcuts permitted.\n";
+    TEST_ASSERT(out.rfind(bos + prefix, 0) == 0);
+    TEST_ASSERT(out.find("system message<｜User｜>hard problem") !=
+                std::string::npos);
+    TEST_ASSERT(out.size() >= std::string("<｜Assistant｜><think>").size());
+    TEST_ASSERT(out.compare(out.size() - std::string("<｜Assistant｜><think>").size(),
+                            std::string("<｜Assistant｜><think>").size(),
+                            "<｜Assistant｜><think>") == 0);
+
+    const std::string high = render_chat_template(
+        msgs, ChatFormat::DEEPSEEK4,
+        /*add_generation_prompt=*/true,
+        /*enable_thinking=*/true,
+        /*tools_json=*/"",
+        /*reasoning_effort=*/"high");
+    TEST_ASSERT(high.find(prefix) == std::string::npos);
+    TEST_ASSERT(high.rfind(bos + "system message", 0) == 0);
+}
