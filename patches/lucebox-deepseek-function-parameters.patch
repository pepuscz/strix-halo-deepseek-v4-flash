+TEST_CASE(ServerUnitFixture, test_parse_deepseek_function_parameters) {
+    std::string text =
+        "{\"function\":\"get_weather\",\"parameters\":{"
+        "\"location\":\"Prague, Czech Republic\",\"unit\":\"celsius\"}}";
+    auto result = parse_tool_calls(text, weather_tools());
